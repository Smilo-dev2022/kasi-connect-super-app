# Global
NODE_ENV=development

# App (Python FastAPI in /app)
DATABASE_URL=postgresql://user:pass@host:5432/app

# events_service (Python)
EVENTS_SECRET_KEY=change-me
EVENTS_DATABASE_URL=postgresql://user:pass@host:5432/events_py
EVENTS_BASE_URL=https://events.example.com
EVENTS_CORS_ORIGINS=["https://app.example.com"]

# events-service (Node)
PORT=3000
EVENTS_DATABASE_URL=postgresql://user:pass@host:5432/events

# backend (Fastify OTP)
PORT=4000
JWT_SECRET=change-me
OTP_PEPPER=change-me
REDIS_URL=redis://host:6379

# agent7-messaging
PORT=8080
JWT_PUBLIC_KEY=...
JWT_AUDIENCE=...

# moderation_service (Python)
MOD_DB_URL=postgresql://user:pass@host:5432/mod

# wallet-service (Node + Prisma)
DATABASE_URL=postgresql://user:pass@host:5432/wallet

# AWS & S3
AWS_REGION=us-east-1
S3_BUCKET_MEDIA=app-media
S3_BUCKET_WEB=web-assets

# Typesense
TYPESENSE_API_KEY=change-me
TYPESENSE_HOST=typesense.example.com
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https

# CORS
CORS_ORIGINS=["https://app.example.com", "https://admin.example.com"]

# Production feature flags for iKasiLink
USE_DB=true
VITE_JWT_ONLY=true
MOD_USE_DB=true
# Sample environment file for iKasiLink
# Global defaults (copy per service as needed)
NODE_ENV=development

# backend (Fastify)
JWT_SECRET=please-change
OTP_PEPPER=please-change
REDIS_URL=redis://localhost:6379

# agent7-messaging
# JWT for dev only; set in prod
# JWT_SECRET=please-change

# services/media
PORT=4008
CORS_ORIGIN=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=media
S3_FORCE_PATH_STYLE=true

# agent9-search
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev

# events_service (FastAPI)
EVENTS_SECRET_KEY=dev-secret-change
EVENTS_DATABASE_URL=sqlite:///events.db
EVENTS_BASE_URL=http://localhost:8000