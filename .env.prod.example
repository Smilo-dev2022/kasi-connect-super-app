# Image tags (published by CI)
WALLET_IMAGE=ghcr.io/your-org/wallet-service:{{SHA_OR_TAG}}
EVENTS_IMAGE=ghcr.io/your-org/events-service-py:{{SHA_OR_TAG}}
MODERATION_IMAGE=ghcr.io/your-org/moderation-service:{{SHA_OR_TAG}}

# Databases (managed Postgres)
WALLET_DATABASE_URL=postgres://USER:PASSWORD@host:5432/wallet_db
EVENTS_DATABASE_URL=postgres://USER:PASSWORD@host:5432/events_db
MOD_DB_URL=postgres://USER:PASSWORD@host:5432/mod_db

# Domains
PUBLIC_BASE_DOMAIN=example.com
API_BASE_HOST=api.example.com
WEB_ADMIN_HOST=admin.example.com
