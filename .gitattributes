# Normalize line endings
text=auto

# Ensure these files are always treated as text and use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.apk binary
*.aab binary
*.ipa binary
*.jar binary
*.zip binary
*.tar binary
*.gz binary
