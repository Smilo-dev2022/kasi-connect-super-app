# Development Environment Configuration for iKasiLink
NODE_ENV=development

# API Endpoints
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_API_URL=http://localhost:4010
VITE_WS_HOST=localhost:8080
VITE_LOGGING_ENDPOINT=http://localhost:4010/logs

# Security
VITE_CSP_NONCE=dev-nonce
VITE_ENABLE_ANALYTICS=false

# Features
VITE_ENABLE_PWA=false
VITE_ENABLE_OFFLINE=false
VITE_ENABLE_PUSH_NOTIFICATIONS=false

# External Services
VITE_SERPAPI_KEY=your_dev_serpapi_key
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Performance
VITE_ENABLE_CACHING=true
VITE_CACHE_TTL=60000
VITE_ENABLE_COMPRESSION=false

# Debug
VITE_DEBUG=true
VITE_LOG_LEVEL=debug
