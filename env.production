# Production Environment Configuration for iKasiLink
NODE_ENV=production

# API Endpoints
VITE_API_BASE_URL=https://api.ikasilink.co.za
VITE_AUTH_API_URL=https://api.ikasilink.co.za/auth
VITE_WS_HOST=api.ikasilink.co.za
VITE_LOGGING_ENDPOINT=https://api.ikasilink.co.za/logs

# Security
VITE_CSP_NONCE=production-nonce
VITE_ENABLE_ANALYTICS=true

# Features
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# External Services
VITE_SERPAPI_KEY=your_production_serpapi_key
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=your_sentry_dsn

# Performance
VITE_ENABLE_CACHING=true
VITE_CACHE_TTL=300000
VITE_ENABLE_COMPRESSION=true

# Debug
VITE_DEBUG=false
VITE_LOG_LEVEL=warn
