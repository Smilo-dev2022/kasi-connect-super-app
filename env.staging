# Staging Environment Configuration for iKasiLink Beta Testing
# This file contains staging-specific environment variables

# API Configuration
VITE_API_BASE_URL=https://staging.api.ikasilink.co.za
VITE_WS_URL=wss://staging.api.ikasilink.co.za/ws
VITE_AUTH_API_URL=https://staging.auth.ikasilink.co.za
VITE_MEDIA_API_URL=https://staging.media.ikasilink.co.za
VITE_MESSAGING_API_URL=https://staging.messaging.ikasilink.co.za
VITE_EVENTS_API_URL=https://staging.events.ikasilink.co.za
VITE_MODERATION_API_URL=https://staging.moderation.ikasilink.co.za
VITE_SEARCH_API_URL=https://staging.search.ikasilink.co.za

# Firebase Configuration (Staging Project)
VITE_FIREBASE_API_KEY=staging_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=ikasilink-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ikasilink-staging
VITE_FIREBASE_STORAGE_BUCKET=ikasilink-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=staging_sender_id
VITE_FIREBASE_APP_ID=staging_app_id
VITE_FIREBASE_MEASUREMENT_ID=staging_measurement_id

# Environment
NODE_ENV=staging
VITE_APP_ENV=staging
VITE_APP_VERSION=1.0.0-staging

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASHLYTICS=true
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_MOCK_DATA=false

# Security
VITE_ENABLE_SSL_PINNING=false
VITE_ENABLE_CERTIFICATE_PINNING=false
VITE_ENABLE_DEBUG_LOGS=true

# Performance
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_BUNDLE_ANALYSIS=false
VITE_ENABLE_SOURCE_MAPS=true

# External Services
VITE_SENTRY_DSN=staging_sentry_dsn
VITE_ANALYTICS_ID=staging_analytics_id
VITE_MIXPANEL_TOKEN=staging_mixpanel_token

# Payment (Sandbox)
VITE_PAYMENT_GATEWAY_URL=https://staging.payments.ikasilink.co.za
VITE_PAYMENT_MERCHANT_ID=staging_merchant_id
VITE_PAYMENT_SANDBOX_MODE=true

# Push Notifications
VITE_FCM_VAPID_KEY=staging_vapid_key
VITE_PUSH_ENDPOINT=https://staging.push.ikasilink.co.za

# CDN and Media
VITE_CDN_URL=https://staging.cdn.ikasilink.co.za
VITE_MEDIA_UPLOAD_URL=https://staging.media.ikasilink.co.za/upload
VITE_THUMBNAIL_URL=https://staging.thumbnails.ikasilink.co.za

# Rate Limiting (More lenient for testing)
VITE_API_RATE_LIMIT=1000
VITE_WS_RATE_LIMIT=500
VITE_UPLOAD_RATE_LIMIT=100

# Timeouts (Longer for testing)
VITE_API_TIMEOUT=30000
VITE_WS_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=60000

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_OFFLINE_CACHE_SIZE=50
VITE_PRELOAD_CACHE=true

# Logging Configuration
VITE_LOG_LEVEL=debug
VITE_LOG_ENDPOINT=https://staging.logs.ikasilink.co.za
VITE_ENABLE_REMOTE_LOGGING=true
VITE_LOG_BATCH_SIZE=10
VITE_LOG_FLUSH_INTERVAL=5000

# Development Tools
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true
VITE_ENABLE_NETWORK_INSPECTOR=true

# Testing
VITE_ENABLE_MOCK_SERVICES=false
VITE_MOCK_API_DELAY=1000
VITE_ENABLE_TEST_DATA=false

# Monitoring
VITE_ENABLE_HEALTH_CHECKS=true
VITE_HEALTH_CHECK_INTERVAL=30000
VITE_METRICS_ENDPOINT=https://staging.metrics.ikasilink.co.za
