NODE_ENV=production
PORT=4010

# CORS (comma-separated origins)
CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# OTP
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
