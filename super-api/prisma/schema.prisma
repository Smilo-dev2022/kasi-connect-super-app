generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  messages  Message[]
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  text           String
  userId         String
  conversationId String
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  title     String
  rsvps     RSVP[]
}

model RSVP {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model WalletRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  amount    Int
  status    String
}

model LedgerEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  requestId String?
  amount    Int
  request   WalletRequest? @relation(fields: [requestId], references: [id])
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  subject   String
  status    String   @default("open")
}

model Appeal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  reportId  String
  message   String
  report    Report   @relation(fields: [reportId], references: [id])
}
